{
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=dotnetauth;User=dotnetauth;Password=12345678;",
    "Cache": "127.0.0.1:6379"
  },
  "Cache": {
    "InstanceName": "dotnetauth",
    "ProfileExpirationMinutes": 5
  },
  "Database": {
    "ApplyMigrations": true,
    "MariaDbServerVersion": "11.7.2",
    "Retry": {
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5
    },
    "Initialization": {
      "MaxAttempts": 10,
      "RetryDelaySeconds": 3
    }
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": true,
      "LockoutOnFailure": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 10,
      "DefaultLockoutMinutes": 15
    }
  },
  "Web": {
    "Authentication": {
      "Registration": true
    }
  },
  "Smtp": {
    "Host": "127.0.0.1",
    "Port": 1025,
    "EnableSsl": false,
    "Username": null,
    "Password": null,
    "FromAddress": "no-reply@dotnetauth.local"
  },
  "OAuth": {
    "Issuer": "http://localhost:5004/",
    "Audience": "api",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "api"
    ],
    "AllowAuthorizationCodeFlow": true,
    "RequireProofKeyForCodeExchange": true,
    "AllowRefreshTokenFlow": true,
    "ClientId": "dotnetauth-local",
    "ClientRedirectUri": "http://localhost:5004/oauth/callback"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
