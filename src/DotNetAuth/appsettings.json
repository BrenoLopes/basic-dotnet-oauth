{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=dotnetauth;User=dotnetauth;",
    "Cache": "localhost:6379"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Web": {
    "Authentication": {
      "Registration": false
    }
  },
  "OAuth": {
    "Issuer": "http://localhost:5004/",
    "TestClientId": "dotnetauth-local",
    "TestClientRedirectUri": "http://localhost:5004/oauth/callback"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "no-reply@dotnetauth.local"
  },
  "AllowedHosts": "*"
}
