{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "InstanceName": "dotnetauth",
    "ProfileExpirationMinutes": 5
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=dotnetauth;User=dotnetauth;",
    "Cache": "localhost:6379"
  },
  "Database": {
    "ApplyMigrations": false,
    "MariaDbServerVersion": "11.7.2",
    "Retry": {
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5
    },
    "Initialization": {
      "MaxAttempts": 10,
      "RetryDelaySeconds": 3
    }
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": true,
      "LockoutOnFailure": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "Web": {
    "Authentication": {
      "Registration": false
    }
  },
  "OAuth": {
    "Issuer": "http://localhost:5004/",
    "Audience": "api",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "api"
    ],
    "AllowAuthorizationCodeFlow": true,
    "RequireProofKeyForCodeExchange": true,
    "AllowRefreshTokenFlow": true,
    "ClientId": "dotnetauth-local",
    "ClientRedirectUri": "http://localhost:5004/oauth/callback"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "Username": null,
    "Password": null,
    "FromAddress": "no-reply@dotnetauth.local"
  },
  "AllowedHosts": "*"
}
