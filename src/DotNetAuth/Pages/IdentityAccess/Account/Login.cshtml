@page "/account/login"
@model DotNetAuth.Pages.IdentityAccess.Account.LoginModel
@{
    ViewData["Title"] = "Entrar";
    var hasErrors = ViewData.ModelState.ErrorCount > 0;
}

<header class="account-card__header">
    <p class="account-eyebrow">Bem-vindo de volta</p>
    <h2>Entre na sua conta</h2>
    <p>
        @(Model.IsOAuthContinuation
            ? "Faça login para continuar com segurança."
            : "Entre para continuar para a sua área.")
    </p>
</header>

@if (hasErrors)
{
    <div class="validation-summary" asp-validation-summary="ModelOnly" role="alert" tabindex="-1"></div>
}

<form method="post" class="account-form">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="form-field">
        <label class="form-label" asp-for="Input.Email">E-mail</label>
        <input class="form-input"
               asp-for="Input.Email"
               autocomplete="email"
               aria-describedby="Input_Email_error"
               aria-invalid="@(ModelState["Input.Email"]?.Errors.Count > 0 ? "true" : "false")" />
        <span class="field-validation"
              asp-validation-for="Input.Email"
              id="Input_Email_error"></span>
    </div>

    <div class="form-field">
        <label class="form-label" asp-for="Input.Password">Senha</label>
        <input class="form-input"
               asp-for="Input.Password"
               type="password"
               autocomplete="current-password"
               aria-describedby="Input_Password_error"
               aria-invalid="@(ModelState["Input.Password"]?.Errors.Count > 0 ? "true" : "false")" />
        <span class="field-validation"
              asp-validation-for="Input.Password"
              id="Input_Password_error"></span>
    </div>

    <label class="remember-field">
        <input class="form-checkbox" asp-for="Input.RememberMe" />
        <span>Lembrar de mim</span>
    </label>

    <button class="account-button" type="submit">Entrar</button>
</form>

@if (Model.IsRegistrationEnabled)
{
    <p class="account-switch">
        Ainda não tem uma conta?
        <a asp-page="/IdentityAccess/Account/Register"
           asp-route-returnUrl="@Model.LocalReturnUrl">Criar conta</a>
    </p>
}
